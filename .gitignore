# ── LaTeX build artifacts ────────────────────────────────────
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.lof
**/*.lot
**/*.lol
**/*.loe
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.synctex(busy)

# ── biblatex / biber ─────────────────────────────────────────
**/*.bbl
**/*.blg
**/*.bcf
**/*.run.xml
**/*-blx.bib

# ── glossaries / index (if ever used) ────────────────────────
**/*.acn
**/*.acr
**/*.alg
**/*.glg
**/*.gls
**/*.glo
**/*.ist
**/*.lox

# ── compiled output ──────────────────────────────────────────
thesis.pdf
output.pdf
# standalone subfile build artifacts are not tracked...
src/01-body/*.pdf
# ...except the ontology-formation pilot, kept in-repo so reviewers see the rendered output
!src/01-body/pembentukan-ontologi.pdf

# ── local fallback copies (not part of the build) ────────────
legacy (ignore)/

# ── OS cruft ─────────────────────────────────────────────────
.DS_Store
