	file = {PDF:/Users/moladin/Zotero/storage/6GGG4KBD/Abu-Rasheed et al. - 2025 - LLM-Assisted Knowledge Graph Completion for Curriculum and Domain Modelling in Personalized Higher E.pdf:application/pdf},
